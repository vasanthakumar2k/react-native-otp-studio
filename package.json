{
  "name": "react-native-otp-studio",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "Beautiful, customizable OTP input for React Native: circle, square, rounded & underline shapes, glass effect, colors, shadows, numeric/alphanumeric/masked types, SMS autofill. Lightweight, zero dependencies, TypeScript. Works with Expo.",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "react-native",
    "otp",
    "otp-input",
    "react-native-otp",
    "react-native-otp-input",
    "otp-textinput",
    "pin",
    "pin-input",
    "pin-code",
    "verification-code",
    "confirmation-code",
    "sms-code",
    "sms-autofill",
    "one-time-password",
    "one-time-code",
    "2fa",
    "mfa",
    "glass",
    "glassmorphism",
    "expo",
    "ios",
    "android",
    "typescript",
    "code-input",
    "input"
  ],
  "author": "Vasanthakumar A <2002vasanthakumar@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasanthakumar2k/react-native-otp-studio.git"
  },
  "bugs": {
    "url": "https://github.com/vasanthakumar2k/react-native-otp-studio/issues"
  },
  "homepage": "https://github.com/vasanthakumar2k/react-native-otp-studio#readme",
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.70"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "react": "^19.3.0",
    "react-native": "^0.88.1",
    "react-test-renderer": "^19.3.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testMatch": [
      "**/__tests__/**/*.test.tsx"
    ]
  }
}
